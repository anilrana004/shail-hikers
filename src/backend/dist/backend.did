type Yatra = 
 record {
   basePrice: nat;
   category: text;
   durationDays: nat;
   heroImage: text;
   id: nat;
   name: text;
   nextDeparture: text;
   shortDescription: text;
   slug: Slug;
   tagline: text;
 };
type WaitlistStatus = 
 variant {
   Booked;
   Expired;
   Notified;
   Waiting;
 };
type WaitlistResult = 
 variant {
   err: text;
   ok: record {
         position: nat;
         waitlistId: text;
       };
 };
type WaitlistEntryPublic = 
 record {
   batchId: text;
   createdAt: int;
   email: text;
   id: text;
   name: text;
   notifiedAt: opt int;
   numPeople: nat;
   phone: text;
   position: nat;
   status: WaitlistStatus;
 };
type UserProfilePublic = 
 record {
   city: text;
   createdAt: Timestamp;
   email: text;
   loyaltyTier: LoyaltyTier;
   name: text;
   phone: text;
   "principal": UserId;
   referralCode: text;
   referralCredits: nat;
   totalTreksCompleted: nat;
   wishlist: vec Slug;
 };
type UserId = principal;
type Trek = 
 record {
   basePrice: nat;
   bestTime: text;
   difficulty: Difficulty;
   durationDays: nat;
   durationNights: nat;
   heroImage: text;
   id: nat;
   isFeatured: bool;
   maxAltitude: nat;
   name: text;
   nearestAirport: text;
   nearestRailhead: text;
   region: text;
   shortDescription: text;
   slug: Slug;
   startingPoint: text;
   tagline: text;
   trekDistance: nat;
 };
type TravelerInfo = 
 record {
   age: nat;
   emergencyContact: text;
   gender: text;
   mealPreference: MealPreference;
   medicalConditions: text;
   name: text;
   tshirtSize: text;
 };
type Timestamp = int;
type Slug = text;
type ReviewPublic = 
 record {
   createdAt: Timestamp;
   foodRating: nat;
   guideRating: nat;
   helpfulVotes: nat;
   id: nat;
   rating: nat;
   reviewText: text;
   safetyRating: nat;
   trekSlug: Slug;
   userCity: text;
   userId: UserId;
   userName: text;
   verified: bool;
 };
type PaymentStatus = 
 variant {
   Cancelled;
   Paid;
   Pending;
 };
type NewsletterPreference = 
 variant {
   BlogPosts;
   NewBatches;
   Offers;
   WeatherAlerts;
 };
type MealPreference = 
 variant {
   NonVeg;
   Veg;
 };
type LoyaltyTier = 
 variant {
   Explorer;
   SummitMaster;
   Trailblazer;
 };
type GuidePublic = 
 record {
   availability: GuideAvailability;
   bio: text;
   certifications: vec text;
   currentAssignment: opt text;
   designation: text;
   favoriteTrek: text;
   id: text;
   name: text;
   photo: text;
   rating: float64;
   totalTreksLed: nat;
   yearsExperience: nat;
 };
type GuideAvailability = 
 variant {
   Available;
   OnLeave;
   OnTrek;
 };
type FaqVotesPublic = 
 record {
   helpful: nat;
   notHelpful: nat;
 };
type Difficulty = 
 variant {
   Difficult;
   Easy;
   Extreme;
   Moderate;
 };
type CorporateLead = 
 record {
   companyName: text;
   contactName: text;
   createdAt: Timestamp;
   email: text;
   headcount: nat;
   id: nat;
   message: text;
   phone: text;
   preferredDates: text;
   preferredTrek: text;
 };
type BookingPublic = 
 record {
   addOns: vec AddOn;
   batchId: nat;
   createdAt: Timestamp;
   id: nat;
   paymentStatus: PaymentStatus;
   stripeSessionId: opt text;
   totalAmount: nat;
   travelers: vec TravelerInfo;
   trekSlug: Slug;
   userId: UserId;
 };
type BlogPostPublic = 
 record {
   author: text;
   category: BlogCategory;
   content: text;
   excerpt: text;
   heroImage: text;
   id: nat;
   publishedAt: Timestamp;
   readTime: nat;
   slug: Slug;
   tags: vec text;
   title: text;
   views: nat;
 };
type BlogCategory = 
 variant {
   Gear;
   Stories;
   TrekTips;
   YatraGuides;
 };
type BatchStatus = 
 variant {
   Cancelled;
   Completed;
   Full;
   Open;
 };
type BatchPublic = 
 record {
   bookedSeats: nat;
   endDate: text;
   guideId: text;
   id: nat;
   isSoldOut: bool;
   pricePerPerson: nat;
   seatsAvailable: nat;
   startDate: text;
   status: BatchStatus;
   totalSeats: nat;
   trekSlug: Slug;
 };
type BatchAvailability = 
 record {
   batchId: nat;
   isSoldOut: bool;
   seatsAvailable: nat;
 };
type AddOn = 
 record {
   name: text;
   pricePerPerson: nat;
 };
service : {
  addToWishlist: (slug: text) -> (bool);
  assignGuideToBatch: (batchId: text, guideId: text) ->
   (variant {
      err: text;
      ok;
    });
  calculateGroupPrice: (trekSlug: text, groupSize: nat, addOns: vec AddOn,
   batchId: nat) -> (nat) query;
  cancelBooking: (id: nat) -> (variant {
                                 err: text;
                                 ok: text;
                               });
  confirmBookingPayment: (bookingId: nat, stripeSessionId: text) ->
   (variant {
      err: text;
      ok: BookingPublic;
    });
  createBooking: (batchId: nat, groupSize: nat, addOns: vec AddOn, travelers:
   vec TravelerInfo, applyEarlyBird: bool) ->
   (variant {
      err: text;
      ok: record {
            bookingId: nat;
            checkoutUrl: text;
            sessionId: text;
          };
    });
  createOrUpdateProfile: (name: text, email: text, phone: text, city:
   text) -> (UserProfilePublic);
  getAdminPrincipal: () -> (opt principal) query;
  getAllGuides: () -> (vec GuidePublic) query;
  getAllTreks: () -> (vec Trek) query;
  getAllYatras: () -> (vec Yatra) query;
  getAvailability: (batchId: nat) ->
   (record {
      available: nat;
      percentFilled: nat;
      "reserved": nat;
      soldOut: bool;
      total: nat;
    }) query;
  getAvailableBatches: () -> (vec BatchPublic) query;
  getAverageRating: (trekSlug: text) -> (nat) query;
  getBatchAvailability: (batchId: nat) -> (opt BatchAvailability) query;
  getBatchById: (id: nat) -> (opt BatchPublic) query;
  getBatchesByTrek: (trekSlug: text) -> (vec BatchPublic) query;
  getBlogByCategory: (category: BlogCategory) -> (vec BlogPostPublic) query;
  getBlogBySlug: (slug: text) -> (opt BlogPostPublic) query;
  getBlogPosts: () -> (vec BlogPostPublic) query;
  getBookingById: (id: nat) -> (opt BookingPublic) query;
  getBookingsByUser: () -> (vec BookingPublic) query;
  getCorporateLeads: () -> (vec CorporateLead);
  getFaqVotes: (trekSlug: text, faqIndex: nat) -> (FaqVotesPublic) query;
  getFeaturedTreks: () -> (vec Trek) query;
  getGuideById: (id: text) -> (opt GuidePublic) query;
  getReviewsByTrek: (trekSlug: text) -> (vec ReviewPublic) query;
  getStripePublicKey: () -> (text) query;
  getSubscriberCount: () -> (nat) query;
  getTrekBySlug: (slug: text) -> (opt Trek) query;
  getTreksByDifficulty: (difficulty: Difficulty) -> (vec Trek) query;
  getUserProfile: () -> (opt UserProfilePublic) query;
  getWaitlistByBatch: (batchId: text) -> (vec WaitlistEntryPublic) query;
  getWaitlistPosition: (batchId: text, email: text) -> (opt nat) query;
  getYatraBySlug: (slug: text) -> (opt Yatra) query;
  incrementBlogViews: (slug: text) -> (bool);
  initAdmin: () -> (variant {
                      err: text;
                      ok;
                    });
  joinWaitlist: (batchId: text, name: text, email: text, phone: text,
   numPeople: nat) -> (WaitlistResult);
  notifyNextOnWaitlist: (batchId: text) -> (bool);
  promoteFromWaitlist: (batchId: text, waitlistId: text) ->
   (variant {
      err: text;
      ok;
    });
  removeFromWishlist: (slug: text) -> (bool);
  sendManualWaitlistNotification: (batchId: text, waitlistId: text, message:
   text) -> (bool);
  setStripeSecretKey: (secretKey: text, publicKey: text) -> ();
  submitCorporateLead: (companyName: text, contactName: text, email: 
   text, phone: text, headcount: nat, preferredDates: text, preferredTrek:
   text, message: text) -> (CorporateLead);
  submitReview: (trekSlug: text, userName: text, userCity: text, rating: 
   nat, guideRating: nat, foodRating: nat, safetyRating: nat, reviewText:
   text) -> (ReviewPublic);
  subscribe: (email: text, preferences: vec NewsletterPreference) -> (bool);
  unsubscribe: (email: text) -> (bool);
  updateGuideAvailability: (guideId: text, availability:
   GuideAvailability) -> (variant {
                            err: text;
                            ok;
                          });
  updatePaymentStatus: (id: nat, status: PaymentStatus) -> (bool);
  upsertGuide: (guide: GuidePublic) -> (variant {
                                          err: text;
                                          ok;
                                        });
  voteFaq: (trekSlug: text, faqIndex: nat, isHelpful: bool) -> (bool);
  voteHelpful: (reviewId: nat) -> (bool);
}
